   230	def build_candidate_indices(total_frames: int, candidate_step: int, short_video_full_threshold: int = 48) -> Tuple[List[int], str]:
   231	    """构造候选帧索引。
   232	
   233	    短视频优先全量 dense 候选，长视频使用固定步长 dense 候选。
   234	    """
   235	
   236	    total_frames = max(1, int(total_frames))
   237	    candidate_step = max(1, int(candidate_step))
   238	    short_video_full_threshold = max(1, int(short_video_full_threshold))
   239	
   240	    if total_frames <= short_video_full_threshold:
   241	        return list(range(total_frames)), "full_dense"
   242	
   243	    indices = list(range(0, total_frames, candidate_step))
   244	    if total_frames > 1 and indices[-1] != total_frames - 1:
   245	        indices.append(total_frames - 1)
   246	    return sorted(dict.fromkeys(indices)), "step_dense"
