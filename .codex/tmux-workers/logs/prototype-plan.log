   157	        return meta
   158	
   159	    streams = payload.get("streams", [])
   160	    fmt = payload.get("format", {})
   161	    video_stream = next((s for s in streams if s.get("codec_type") == "video"), {})
   162	
   163	    def _to_int(value: Any) -> Optional[int]:
   164	        try:
   165	            if value is None:
   166	                return None
   167	            return int(float(value))
   168	        except (TypeError, ValueError):
   169	            return None
   170	
   171	    def _to_float(value: Any) -> Optional[float]:
