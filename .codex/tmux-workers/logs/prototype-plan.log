   145	def even_frame_indices(total_frames: int, count: int) -> List[int]:
   146	    """在整段视频上均匀取帧。"""
   147	
   148	    if total_frames <= 1:
   149	        return [0]
   150	
   151	    count = max(1, min(count, total_frames))
   152	    if count == 1:
   153	        return [0]
   154	    if count == total_frames:
   155	        return list(range(total_frames))
   156	
   157	    raw = [int(round(i * (total_frames - 1) / (count - 1))) for i in range(count)]
   158	    indices: List[int] = []
   159	    for idx in raw:
   160	        if idx not in indices:
   161	            indices.append(idx)
   162	    return indices
