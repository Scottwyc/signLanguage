    parser.add_argument("--output-dir", default=str(DEFAULT_OUTPUT_DIR), help="输出目录")
    parser.add_argument("--workers", type=int, default=0, help="并行进程数，0 表示使用 CPU 核数")
    args = parser.parse_args(argv)

