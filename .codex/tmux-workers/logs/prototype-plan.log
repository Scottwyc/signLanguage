   182	        num, den = avg_rate.split("/", 1)
   183	        try:
   184	            num_f = float(num)
   185	            den_f = float(den)
   186	            fps = num_f / den_f if den_f else None
   187	        except ValueError:
   188	            fps = None
   189	
   190	    duration = _to_float(fmt.get("duration")) or _to_float(video_stream.get("duration"))
   191	    frame_count = _to_int(video_stream.get("nb_frames"))
   192	    width = _to_int(video_stream.get("width"))
   193	    height = _to_int(video_stream.get("height"))
   194	
   195	    meta.update(
