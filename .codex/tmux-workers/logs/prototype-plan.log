   167	
   168	    if target_count <= 0:
   169	        return []
   170	    unique = [int(idx) for idx in frame_indices if int(idx) >= 0]
   171	    if not unique:
   172	        return []
   173	    if len(unique) <= target_count:
   174	        return list(dict.fromkeys(unique))
