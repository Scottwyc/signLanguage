   186	def summarize_rows(meta: Dict[str, Any], total_frames: int, rows: Sequence[Dict[str, Any]]) -> Dict[str, Any]:
   187	    """从一组已经完成 Holistic 评估的帧里汇总视频级统计。"""
   188	
   189	    processed = [dict(row) for row in rows]
   190	    fps = float(meta.get("fps") or 25.0)
   191	    first_sample_frame = processed[0]["frame_idx"] if processed else None
   192	    last_sample_frame = processed[-1]["frame_idx"] if processed else None
   193	    frame_span_ratio = None
   194	    tail_coverage_ratio = None
   195	    late_half_fraction = None
   196	    late_75_fraction = None
   197	
   198	    if processed and total_frames > 1:
   199	        frame_span_ratio = (last_sample_frame - first_sample_frame) / (total_frames - 1)
   200	        tail_coverage_ratio = last_sample_frame / (total_frames - 1)
   201	        late_half_fraction = sum(1 for r in processed if r["frame_idx"] >= 0.5 * (total_frames - 1)) / len(processed)
   202	        late_75_fraction = sum(1 for r in processed if r["frame_idx"] >= 0.75 * (total_frames - 1)) / len(processed)
   203	
   204	    motions = [float(r.get("motion_energy", 0.0)) for r in processed]
   205	    pose_ratio = (sum(1 for r in processed if r.get("pose_present")) / len(processed)) if processed else None
   206	    left_ratio = (sum(1 for r in processed if r.get("left_hand_present")) / len(processed)) if processed else None
   207	    right_ratio = (sum(1 for r in processed if r.get("right_hand_present")) / len(processed)) if processed else None
   208	    face_ratio = (sum(1 for r in processed if r.get("face_present")) / len(processed)) if processed else None
   209	
   210	    return {
   211	        "samples": len(processed),
   212	        "sampled_frame_indices": [r["frame_idx"] for r in processed],
   213	        "video_total_frames": total_frames,
   214	        "video_fps": fps,
   215	        "first_sample_frame": first_sample_frame,
   216	        "last_sample_frame": last_sample_frame,
   217	        "pose_presence_ratio": pose_ratio,
   218	        "left_hand_presence_ratio": left_ratio,
   219	        "right_hand_presence_ratio": right_ratio,
   220	        "face_presence_ratio": face_ratio,
   221	        "motion_energy_mean": (sum(motions) / len(motions)) if motions else None,
   222	        "motion_energy_max": max(motions) if motions else None,
   223	        "frame_span_ratio": frame_span_ratio,
   224	        "tail_coverage_ratio": tail_coverage_ratio,
   225	        "late_half_fraction": late_half_fraction,
   226	        "late_75_fraction": late_75_fraction,
   227	    }
